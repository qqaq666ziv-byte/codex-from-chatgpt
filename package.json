{
  "name": "autodev",
  "version": "0.4.0",
  "private": true,
  "description": "Local Codex execution and versioned review evidence for ordinary ChatGPT Chat",
  "license": "MIT",
  "author": "Antonio Ulloa",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "test:real": "tsx scripts/real-smoke.ts",
    "probe": "tsx scripts/probe-app-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "diff": "8.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqaq666ziv-byte/codex-from-chatgpt.git"
  },
  "homepage": "https://github.com/qqaq666ziv-byte/codex-from-chatgpt/tree/codex/autodev-product#readme",
  "bugs": {
    "url": "https://github.com/qqaq666ziv-byte/codex-from-chatgpt/issues"
  }
}
